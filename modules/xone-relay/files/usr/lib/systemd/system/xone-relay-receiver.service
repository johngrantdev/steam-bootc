[Unit]
Description=Xbox controller relay receiver (uinput virtual controller)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=XONE_RELAY_CONFIG=/etc/steam-session/xone-relay.conf
ExecStart=/usr/libexec/steam-session/xone-relay-receiver
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
