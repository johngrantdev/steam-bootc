schema-version 1

description "Proton-CachyOS (the SLR/Steam Linux Runtime build, not the CachyOS-base build) installed system-wide under /usr/share/steam/compatibilitytools.d, where Steam looks for compatibility tools. Steam lists it as proton-cachyos in a game's Compatibility settings."

supports "fedora"

network "scripts"

requires "build-environment"

asset "proton" {
    pin {
        renovate datasource="github-releases" depName="CachyOS/proton-cachyos" extractVersion="^cachyos-(?<version>.+)$"
        version "11.0-20261015-slr"
        url "https://github.com/CachyOS/proton-cachyos/releases/download/cachyos-{version}/proton-cachyos-{version}-x86_64.tar.xz"
        sha256 "35e16eab636724e3ed7aa8e2dbc33eb8e102e0c63bbc28b5a39af544c75d5bd3"
    }
}

packages "curl" "tar" "xz"
