#!/usr/bin/bash
set -euo pipefail

source /etc/default/waydroid-launcher

if ! grep -q 'persist.waydroid.udev=true' /var/lib/waydroid/waydroid_base.prop; then
    sudo sh -c 'echo persist.waydroid.udev=true >> /var/lib/waydroid/waydroid_base.prop'
fi
if ! grep -q 'persist.waydroid.uevent=true' /var/lib/waydroid/waydroid_base.prop; then
    sudo sh -c 'echo persist.waydroid.uevent=true >> /var/lib/waydroid/waydroid_base.prop'
fi
sudo sed -i "s/ro.hardware.gralloc=.*/ro.hardware.gralloc=${WAYDROID_GRALLOC:-minigbm_gbm_mesa}/g" \
    /var/lib/waydroid/waydroid_base.prop

sudo systemctl start waydroid-container.service
